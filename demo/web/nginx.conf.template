server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's built-in DNS. Resolving at request time (not at startup) lets this
  # container run on its own, before an "api" container exists.
  resolver 127.0.0.11 valid=5s;
  resolver_timeout 2s;

  location /api/ {
    set $api ${API_URL};
    proxy_pass $api;
    proxy_set_header Host $http_host;               # keeps the port, so the API can build links like http://host:3000/api/r/abc
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
