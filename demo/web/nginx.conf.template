server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's built-in DNS (only exists on a user-defined network, like "magic").
  # Resolving at request time means the API container can be recreated without restarting this one.
  resolver 127.0.0.11 valid=5s;
  resolver_timeout 2s;

  # forward /api to the API. ${API_URL} is filled in from the environment when the container starts
  location /api/ {
    set $api ${API_URL};
    proxy_pass $api;
    proxy_set_header Host $http_host;               # keeps the port, so the API can build links like http://host:3000/api/r/abc
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
